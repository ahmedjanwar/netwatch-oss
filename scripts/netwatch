#!/usr/bin/env bash
# The `netwatch` command, installed to /usr/local/bin by install.sh.
set -euo pipefail

DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
cd "$DIR"
NETPLAN=/etc/netplan/99-netwatch-static.yaml
export
bold=$(printf '\033[1m'); dim=$(printf '\033[2m'); green=$(printf '\033[32m'); red=$(printf '\033[31m'); off=$(printf '\033[0m')
say()  { printf '%s\n' "${bold}==>${off} $*"; }
fail() { printf '%s\n' "${red}✗ $*${off}" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || fail "Run it with sudo:  sudo netwatch $*"; }
port() { grep -E '^NW_PORT=' .env 2>/dev/null | cut -d= -f2 || true; }
url() {
  local ip; ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')
  echo "http://${ip:-this-machine}:$(port || echo 8088)"
}
running() { [ "$(docker inspect -f '{{.State.Running}}' netwatch 2>/dev/null)" = true ]; }
# A value from Netwatch's own config (what setup saved, else what it detected).
cfg() { docker exec netwatch python -c "from app import config as C; print(C.$1)" 2>/dev/null; }
save_setting() { docker exec netwatch python -c "from app.setup import save_settings; save_settings($1)"; }
healthy() {
  for _ in $(seq 1 30); do
    sleep 1
    running && docker logs --since 40s netwatch 2>&1 | grep -q "dnsmasq.*started" && return 0
  done
  return 1
}

usage() {
  cat <<EOF
${bold}netwatch${off}: manage the Netwatch install in $DIR

  status              is it running, and where's the dashboard
  password            show the temporary password from the installer
  reset-password      forgot it? make a new temporary password
  logs                follow the logs (Ctrl-C to stop)
  restart             restart Netwatch
  static-ip [revert]  give this machine a fixed IP (needed before gateway mode)
  gateway on|off      turn gateway mode on or off (same as the dashboard's setup guide)
  update              update to the latest version (with self-test and automatic rollback)
  uninstall           remove Netwatch

Most commands need sudo.
EOF
}

cmd=${1:-help}; shift || true
case "$cmd" in
  status)
    if running; then
      echo "${green}●${off} Netwatch is running  ${dim}($(docker inspect -f '{{.State.StartedAt}}' netwatch | cut -d. -f1 | tr T ' '))${off}"
      echo "  Dashboard: $(url)"
      echo "  Mode:      $(cfg 'DHCP_ENABLED' | sed 's/True/gateway/;s/False/monitor only/')"
    else
      echo "${red}●${off} Netwatch is not running. Try:  sudo netwatch restart   or see  sudo netwatch logs"
      exit 1
    fi ;;

  password)
    need_root password
    if [ -s data/initial-password ]; then
      echo "Temporary password: ${bold}$(cat data/initial-password)${off}"
      echo "${dim}You'll be asked to change it when you sign in at $(url)${off}"
    else
      echo "The temporary password was already changed. If you forgot yours, run:  sudo netwatch reset-password"
    fi ;;

  reset-password)
    need_root reset-password
    rm -f data/auth.json data/initial-password
    docker restart netwatch >/dev/null
    for _ in $(seq 1 20); do [ -s data/initial-password ] && break; sleep 1; done
    [ -s data/initial-password ] || fail "Netwatch didn't come back. See:  sudo netwatch logs"
    echo "New temporary password: ${bold}$(cat data/initial-password)${off}"
    echo "${dim}Sign in at $(url); you'll choose a new password straight away. Other browsers are signed out.${off}" ;;

  logs) docker logs -f --tail 100 netwatch ;;

  restart) need_root restart; docker restart netwatch >/dev/null && healthy && echo "Restarted." ;;

  static-ip)
    need_root static-ip
    command -v netplan >/dev/null || fail "This command uses netplan (Ubuntu). On other systems, give this machine a fixed IP in your network settings."
    if [ "${1:-}" = revert ]; then
      rm -f "$NETPLAN"; netplan apply; echo "Back to getting an address from DHCP."; exit 0
    fi
    running || fail "Netwatch isn't running."
    IFACE=$(cfg IFACE); IP=$(cfg SELF_IP); GW=$(cfg ROUTER_IP); LAN=$(cfg LAN)
    case "$IFACE" in wl*) echo "${dim}Note: $IFACE is Wi-Fi. A wired connection is much more reliable for a gateway.${off}";; esac
    say "Fixing $IFACE at $IP (router $GW, network $LAN)"
    cat > "$NETPLAN" <<YAML
# Managed by Netwatch (sudo netwatch static-ip). Undo with: sudo netwatch static-ip revert
network:
  version: 2
  ethernets:
    $IFACE:
      dhcp4: false
      dhcp6: false
      addresses: [$IP/${LAN#*/}]
      routes:
        - to: default
          via: $GW
      nameservers:
        addresses: [9.9.9.9, 149.112.112.112]
YAML
    chmod 600 "$NETPLAN"
    netplan generate && netplan apply
    sleep 3
    if ping -c 2 -W 2 1.1.1.1 >/dev/null; then
      echo "${green}Static IP active and internet works.${off}"
    else
      rm -f "$NETPLAN"; netplan apply
      fail "No internet with the fixed address, so it was undone. Check the network settings in the dashboard."
    fi ;;

  gateway)
    need_root gateway
    case "${1:-}" in
      on)
        ip -4 addr show "$(cfg IFACE)" | grep -q dynamic \
          && fail "This machine still gets its IP from DHCP. Run  sudo netwatch static-ip  first."
        save_setting dhcp=True ;;
      off) save_setting dhcp=False ;;
      *) fail "usage: sudo netwatch gateway on|off" ;;
    esac
    docker restart netwatch >/dev/null && healthy
    echo "Gateway mode: $1"
    [ "$1" = off ] && echo "${dim}Turn your router's DHCP server back on, then reconnect your devices.${off}" ;;

  update)
    need_root update
    [ -d .git ] || fail "This copy wasn't installed from git, so it can't update itself. Reinstall to update."
    say "Downloading the latest version"
    old=$(git rev-parse HEAD)
    git fetch -q --depth 1 origin && git reset -q --hard FETCH_HEAD
    [ "$(git rev-parse HEAD)" = "$old" ] && { echo "Already up to date."; exit 0; }
    docker image inspect netwatch:latest >/dev/null 2>&1 && docker tag netwatch:latest netwatch:prev
    docker compose build -q
    say "Self-test"
    if ! docker run --rm --network none --cap-add NET_ADMIN netwatch:latest python -m app.selftest >/dev/null 2>&1; then
      docker tag netwatch:prev netwatch:latest 2>/dev/null || true; git reset -q --hard "$old"
      fail "The new version failed its self-test. Nothing changed; the current version keeps running."
    fi
    docker compose up -d >/dev/null
    if healthy; then
      echo "${green}Updated to $(git log -1 --format='%h %s').${off}"
    else
      echo "${red}The new version didn't start properly; going back to the previous one.${off}" >&2
      git reset -q --hard "$old"
      docker tag netwatch:prev netwatch:latest 2>/dev/null && docker compose up -d --no-build --force-recreate >/dev/null
      healthy && echo "Rolled back." >&2
      exit 1
    fi ;;

  uninstall)
    need_root uninstall
    if running && [ "$(cfg DHCP_ENABLED)" = True ]; then
      echo "${red}${bold}Gateway mode is on.${off} Your devices get their addresses from Netwatch."
      echo "Turn your router's DHCP server back on ${bold}before${off} uninstalling, or devices will lose internet."
      read -r -p "Is your router's DHCP back on? [y/N] " a < /dev/tty; [ "$a" = y ] || exit 1
    fi
    read -r -p "Remove Netwatch from $DIR? [y/N] " a < /dev/tty; [ "$a" = y ] || exit 1
    docker compose down >/dev/null 2>&1 || true
    docker image rm netwatch:latest netwatch:prev >/dev/null 2>&1 || true
    if [ -f "$NETPLAN" ]; then
      read -r -p "Also undo the fixed IP address? [Y/n] " a < /dev/tty
      [ "$a" = n ] || { rm -f "$NETPLAN"; netplan apply; }
    fi
    read -r -p "Delete your Netwatch data (device names, history, settings)? [y/N] " a < /dev/tty
    rm -f /usr/local/bin/netwatch
    if [ "$a" = y ]; then
      cd / && rm -rf "$DIR"; echo "Netwatch removed, including its data."
    else
      find "$DIR" -mindepth 1 -maxdepth 1 ! -name data -exec rm -rf {} +
      echo "Netwatch removed. Your data is kept in $DIR/data."
    fi ;;

  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
