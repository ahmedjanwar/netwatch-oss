# Netwatch settings. The installer creates .env with just the port; everything else is
# set in the dashboard (first-run setup and Settings). Only add these if you need to
# override what Netwatch detects.

# Dashboard port
NW_PORT=8088

# Network (detected automatically; set only if detection gets it wrong)
# NW_IFACE=eth0
# NW_SELF_IP=192.168.1.10
# NW_ROUTER_IP=192.168.1.1
# NW_LAN=192.168.1.0/24
# NW_ROUTER_NAME=My router

# Your link speed in Mb/s, if your network card doesn't report it (Wi-Fi, VMs)
# NW_LINK_MBPS=1000

# Upstream DNS (Quad9 blocks known malware domains)
# NW_DNS_UPSTREAMS=9.9.9.9,149.112.112.112

# DHCP in gateway mode (defaults: the whole LAN except this machine and the router, 1h leases)
# NW_DHCP_RANGES=192.168.1.100,192.168.1.199
# NW_DHCP_LEASE=1h
